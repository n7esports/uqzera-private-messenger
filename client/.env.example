# UQZERA client environment — copy to .env.local and fill in.
# NEVER commit real values; .env.local and .env.production are gitignored.

# Supabase project (Realtime transport). Both are required — there are no
# hardcoded fallbacks in source.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional: self-hosted ws relay URL (server/src/index.js).
NEXT_PUBLIC_RELAY_URL=ws://localhost:8080

# Production relay (Render) — set this in Vercel/Render env (uncommented):
# NEXT_PUBLIC_RELAY_URL=wss://uqzera-private-messenger.onrender.com

# server-only, never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWKS_URL=
UQZERA_SESSION_SECRET=
UPLOAD_HMAC_SECRET=

# UQZERA_RELAY_TOKEN (server only, set on Render; required in production)
